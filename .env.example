# .env.local로 복사해 값을 넣는다(.env.local은 커밋하지 않는다). 열쇠는 브라우저용 공개 열쇠 둘(Supabase)과 서버 전용 AI 열쇠 하나 — service role 키는 두지 않는다
# 값은 따로 연 터미널에서 `npm run e2e:env`로 넣는다(입력이 화면에 보이지 않는다)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# E2E 시험 계정 4개(Supabase 대시보드에서 Auto Confirm으로 만든 이메일 계정). 이메일 앞부분(@ 앞)에 역할 표시
# (e2e-admin·e2e-approved·e2e-pending·e2e-new), 비밀번호 16자 이상, 신청 전(e2e-new) 이메일은 40자 이상
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_APPROVED_EMAIL=
E2E_APPROVED_PASSWORD=
E2E_PENDING_EMAIL=
E2E_PENDING_PASSWORD=
E2E_NEW_EMAIL=
E2E_NEW_PASSWORD=

# AI 리포트(서버 전용). NEXT_PUBLIC_ 금지. 값은 npm run ai:key로 넣는다
ANTHROPIC_API_KEY=
