<Project Sdk="Microsoft.NET.Sdk">
  <!-- 늘 켜 두는 접수 현황 프로그램(윈도우, .NET Framework 4.8, design.md 9절). 창 없는 윈도우 프로그램(WinExe)이라 콘솔 창이 뜨지 않는다.
       켜는 차례는 Core ReceptionStart, 서버·비트 읽기도 Core에 있고 여기는 진짜 부품(뮤텍스·DPAPI·비트 DB·브라우저 열기)을 잇기만 한다.
       설치 폴더 app\에 PrecheckHelper.exe와 함께 놓여 같은 data\·logs\ 폴더를 쓴다 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>Precheck.Reception</RootNamespace>
    <AssemblyName>PrecheckReception</AssemblyName>
    <!-- 비트 DLL이 32비트라 도우미처럼 32비트로 돈다(CLR 머리 32BITREQUIRED, AC-1412.5).
         Platform·Platforms·OutputPath는 쓰지 않는다: 출력이 bin/Release/net48 그대로여야 helper.yml zip 단계가 찾는다 -->
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <!-- 리눅스·Actions에서 net48을 빌드하려고(빌드에만 쓰고 결과물에는 들어가지 않는다) -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Precheck.Core/Precheck.Core.csproj" />
    <ProjectReference Include="../Precheck.Windows/Precheck.Windows.csproj" />
  </ItemGroup>

  <!-- PrecheckReception.exe.config의 <startup>: 도우미(Precheck.Helper.csproj)와 글자 그대로 같다(useLegacyV2RuntimeActivationPolicy="true", sku 4.8).
       비트 DLL이 옛 런타임(v2)용 혼합 어셈블리를 불러도 4.x 런타임에서 돌게 한다.
       App.config 파일을 따로 두지 않고 빌드 때 obj/에 쓴다. 빌드가 여기에 바인딩 리디렉트(System.Text.Json 등)를 더해
       bin/Release/net48/PrecheckReception.exe.config를 만든다 -->
  <PropertyGroup>
    <StartupAppConfigXml><![CDATA[<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
</configuration>]]></StartupAppConfigXml>
  </PropertyGroup>

  <!-- PrepareForBuild가 $(AppConfig)를 읽기 전에 쓴다 -->
  <Target Name="WriteStartupAppConfig" BeforeTargets="PrepareForBuild">
    <PropertyGroup>
      <AppConfig>$(IntermediateOutputPath)startup.App.config</AppConfig>
    </PropertyGroup>
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <WriteLinesToFile File="$(AppConfig)" Lines="$(StartupAppConfigXml)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <FileWrites Include="$(AppConfig)" />
    </ItemGroup>
  </Target>
</Project>
