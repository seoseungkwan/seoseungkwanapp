<Project Sdk="Microsoft.NET.Sdk">
  <!-- 플랫폼과 상관없는 도우미 부분. 이 서버(리눅스)에서도 dotnet test로 시험한다 (ADR-016) -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>Precheck.Core</RootNamespace>
    <AssemblyName>Precheck.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <!-- 명령 표 원본 하나: 확장·웹·도우미가 같은 파일을 읽는다 (design.md 4-3) -->
    <EmbeddedResource Include="../../../src/lib/bridge/commands.json" LogicalName="commands.json" />
    <!-- 수납 구글 코드(google-link design.md 8-1). sheet.code가 비밀 글자 자리 __TOKEN__을 바꿔 클립보드에 넣는다(SheetCode.Load) -->
    <EmbeddedResource Include="../../../google-code/sheet/Code.gs" LogicalName="SheetCode.gs" />
  </ItemGroup>
</Project>
