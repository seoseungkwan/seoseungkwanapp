#!/usr/bin/python3 -I
"""TASK 의 테스트를 실행하고 결과를 RED/GREEN 으로 tdd-log.jsonl 에 기록한다.

  tdd-run TASK-1 --expect red     실패해야 정상 (RED 확인). 통과하면 exit 1 — 테스트가 동작을 검증하지 못함
  tdd-run TASK-1 --expect green   통과해야 정상 (GREEN/REFACTOR 확인)
  tdd-run TASK-1                  결과만 기록 (exit 코드는 테스트 결과 그대로)
  tdd-run --all                   전체 테스트(commands.test) 실행·기록

sdd-guard 훅은 이 기록(RED)이 있어야 구현 파일 수정을 허용한다.
"""
import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
import sddlib as L  # noqa: E402


def main():
    ap = argparse.ArgumentParser(prog="tdd-run")
    ap.add_argument("task", nargs="?")
    ap.add_argument("--all", action="store_true")
    ap.add_argument("--expect", choices=("red", "green"))
    ap.add_argument("--feature")
    ap.add_argument("--timeout", type=int, default=600)
    a = ap.parse_args()

    root = L.git_root(Path.cwd())
    if root is None:
        sys.exit("git 저장소 안에서 실행하세요.")
    cfg = L.load_config(root)
    if cfg is None:
        sys.exit(f"{L.CONFIG_REL} 가 없습니다. 먼저 `sdd init <기능ID>`.")
    fid = a.feature or L.active_feature(root)
    if not fid:
        sys.exit("활성 SDD 기능이 없습니다.")

    task, tests = None, None
    if not a.all:
        if not a.task:
            sys.exit("TASK ID 를 주거나 --all 을 쓰세요.")
        task = next((t for t in L.load_tasks(root, fid) if t["id"] == a.task), None)
        if task is None:
            sys.exit(f"{a.task} 가 specs/{fid}/tasks.md 에 없습니다.")
        tests = [t for t in task["tests"] if any(c in t for c in "*?[") or (root / t).exists()]
        if not tests:
            sys.exit(f"{a.task} 의 테스트 파일이 아직 없습니다: {', '.join(task['tests']) or '(Tests 비어 있음)'}")

    cmd = L.build_test_command(cfg, tests)
    if not cmd:
        sys.exit("테스트 명령이 없습니다. 사용자가 .harness/config.json 의 commands.test(_file)를 설정해야 합니다.")
    print(f"$ {cmd}")
    code, tail = L.run_shell(cmd, root, a.timeout)
    print(tail)
    phase = L.test_phase(code)  # 시간 초과는 TIMEOUT — RED 로 기록하면 구현 차단이 풀린다
    reqs = task["reqs"] if task else []
    L.append_log(root, fid, {"task": task["id"] if task else None, "reqs": reqs, "phase": phase, "exit": code,
                             "cmd": cmd, "tests": tests or [], "expect": a.expect, "source": "tdd-run"})
    print(f"\n[tdd-run] {task['id'] if task else 'ALL'} {phase} (exit {code}) → specs/{fid}/tdd-log.jsonl 기록"
          + (f" · REQ: {', '.join(reqs)}" if reqs else ""))
    if a.expect == "red":
        if code == 0:
            print("✗ RED 기대였지만 테스트가 통과했습니다. 테스트가 새 동작을 실제로 검증하는지 확인하세요.")
            return 1
        if code is None:
            print("✗ 시간 초과는 RED 로 인정하지 않습니다.")
            return 1
        print("✓ RED 확인 — 이제 테스트를 통과시키는 최소 구현을 작성하세요.")
        return 0
    if a.expect == "green":
        print("✓ GREEN" if code == 0 else "✗ 아직 실패합니다.")
        return 0 if code == 0 else 1
    return 0 if code == 0 else 1


if __name__ == "__main__":
    sys.exit(main())
