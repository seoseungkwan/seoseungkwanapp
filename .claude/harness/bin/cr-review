#!/usr/bin/python3 -I
"""현재 브랜치의 커밋된 변경을 CodeRabbit CLI 로 리뷰하고, 결과를 PR 생성 게이트용으로 기록한다.

  ~/.claude/harness/bin/cr-review [--base <브랜치>]

  종료 코드  0 통과 (critical/major 없음) — push 후 `gh pr create --base <브랜치>` 가능
            2 막는 지적 있음 — 고친 뒤 verify → harness-reviewer → 커밋 → 다시 실행
            1 결과를 확인하지 못함 (미설치·버전·로그인·사용량 제한·시간 초과·출력 이상·테스트 없음 등) — 통과로 보지 않는다
            3 막힌 리뷰가 저장소에서 max_rounds(기본 3)회에 이름 — 멈추고 사용자에게 보고 (사용자가 `CR-RESET` 입력 시 재시작)

먼저 확인하는 것: 커밋되지 않은 변경이 없을 것, 지금 코드가 verify 를 통과했을 것(CodeRabbit 저장소는 테스트 명령이 꼭 있어야 함).
CLI 는 정책의 절대 경로(cli)만 실행하고, 버전(cli_version)을 확인하고, 접속 대상·인증서·프록시를 바꾸는 환경 변수는 넘기지 않는다.
리뷰가 몇 분 걸릴 수 있다 (사용량 제한 대기 최대 15분). Bash 도구에서는 run_in_background 로 실행한다.
"""
import argparse
import json
import os
import re
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
import crlib as CR  # noqa: E402
import sddlib as L  # noqa: E402

OUTPUT_LIMIT = 4 * 1024 * 1024
DROP_ENV = re.compile(r"^(CODERABBIT_|CR_CLI_|NODE_|BUN_|SSL_CERT_|LD_|DYLD_|GIT_)"
                      r"|^(REQUESTS_CA_BUNDLE|CURL_CA_BUNDLE)$|_PROXY$", re.IGNORECASE)
NEXT = ("다음 순서: critical/major 를 고친다 → `python3 ~/.claude/harness/bin/verify` → harness-reviewer PASS → 커밋 → "
        "`~/.claude/harness/bin/cr-review` 다시 실행. 테스트를 지우거나 약화시켜 통과시키지 마라.")
UNCONFIRMED = "\n\n결과를 확인하지 못했으므로 통과로 보지 않는다. PR 을 만들지 마라. 해결할 수 없으면 사용자에게 보고하라."


def show(f: dict, detail: bool) -> str:
    line = f"[{f['severity']}] {CR.redact(f['location'])} — {CR.redact(f['title']) or '(제목 없음)'}"
    if detail:
        if f["comment"]:
            line += "\n   " + CR.redact(f["comment"])[:800].replace("\n", "\n   ")
        if f["fix"]:
            line += "\n   고치는 방법: " + CR.redact(f["fix"])[:1200].replace("\n", "\n   ")
    return line


def stop(msg: str, code: int) -> int:
    print(msg)
    return code


def main() -> int:
    ap = argparse.ArgumentParser(description="CodeRabbit 리뷰 게이트")
    ap.add_argument("--base", help="비교할 base 브랜치 (기본: 정책의 base)")
    args = ap.parse_args()
    for k in [k for k in os.environ if DROP_ENV.search(k)]:
        del os.environ[k]  # git 대상(GIT_DIR 등)·CLI 접속 대상을 바꾸는 환경 변수는 이 프로세스와 자식 모두에서 뺀다

    root = L.git_root(Path.cwd())
    if root is None:
        return stop("git 저장소 안에서 실행하세요.", 1)
    pol = CR.load_policy()
    if pol.get("_error"):
        print(f"[경고] {pol['_error']} — 모든 GitHub 저장소를 CodeRabbit 대상으로 봅니다. 사용자에게 알려라.")
    gate, max_rounds, base = pol["gate"], int(pol["max_rounds"]), args.base or pol["base"]
    cr_repo = CR.enabled(root)
    if not cr_repo:
        print(f"[참고] 이 저장소({CR.repo_slug(root) or 'GitHub origin 없음'})는 CodeRabbit 게이트 대상이 아닙니다 "
              f"(정책: {CR.policy_path()}). 리뷰는 진행하지만 PR 생성은 막지 않습니다.")

    cli = CR.expand(pol["cli"])
    if not (os.path.isabs(cli) and os.path.isfile(cli) and os.access(cli, os.X_OK)):
        return stop(f"✗ CodeRabbit CLI 가 정책 경로({cli})에 없습니다. 사용자에게 설치를 요청하라." + UNCONFIRMED, 1)
    env = dict(os.environ, CODERABBIT_CLI_DISABLE_AUTO_UPDATE="true", NO_COLOR="1")
    if pol.get("cli_version"):
        try:
            ver = subprocess.run([cli, "--version"], capture_output=True, text=True, timeout=30, env=env).stdout.strip()
        except Exception as e:
            ver = f"확인 실패: {e}"
        if ver != pol["cli_version"]:
            return stop(f"✗ CodeRabbit CLI 버전이 정책({pol['cli_version']})과 다릅니다 ({ver}). 출력 형식이 바뀌었을 수 "
                        f"있어 믿지 않습니다. 사용자가 확인하고 정책 cli_version 을 고쳐야 한다." + UNCONFIRMED, 1)

    before = CR.snapshot(root)
    if not before["clean"]:
        return stop("✗ 커밋되지 않은 변경이 있습니다. CodeRabbit 은 커밋된 변경(PR 에 들어갈 내용)을 리뷰합니다. "
                    "harness-reviewer PASS 후 커밋하고 다시 실행하라.\n  " + "\n  ".join(L.changed_files(root)[:20]), 1)
    if cr_repo and not CR.has_test_command(root):
        return stop("✗ 이 CodeRabbit 저장소에는 실행할 테스트 명령이 없어 '테스트 실패 시 PR 중단'을 지킬 수 없습니다. "
                    "사용자에게 정책(~/.claude/harness/coderabbit.json)의 tests 설정이나 package.json 의 test 스크립트를 "
                    "요청하라 (테스트가 없는 저장소면 tests 에 \"none\")." + UNCONFIRMED, 1)
    cmds = L.verify_commands(root, L.load_config(root))
    if cmds:
        try:
            ok = json.loads(L.verified_path(root).read_text()).get("code_hash") == L.code_hash(root)
        except Exception:
            ok = False
        if not ok:
            return stop("✗ 지금 코드의 테스트 통과 기록이 없습니다. 먼저 `python3 ~/.claude/harness/bin/verify`를 "
                        "통과시킨 뒤 다시 실행하라 (테스트 → 리뷰 순서). 통과하지 못하면 PR 을 만들지 마라.", 1)

    rounds = CR.read_rounds(root)
    if rounds >= max_rounds:
        return stop(f"✗ 이 저장소의 CodeRabbit 리뷰가 이미 {rounds}/{max_rounds}회 막혔습니다. 더 고치지 말고 멈춰서 마지막 "
                    f"결과를 사용자에게 보고하라. PR 을 만들지 마라. 사용자가 입력창에 `CR-RESET`을 입력하면 다시 시작할 수 있다.", 3)

    cmd = [cli, "review", "--agent", "--gate", gate, "--committed", "--base", base]
    ctx = [f for f in pol.get("context_files") or [] if (root / f).is_file()]
    if ctx:
        cmd += ["-c", *ctx]
    print(f"$ coderabbit {' '.join(cmd[1:])}", flush=True)
    try:
        r = subprocess.run(cmd, cwd=root, capture_output=True, timeout=int(pol["timeout"]), env=env)
        stdout, code = r.stdout[:OUTPUT_LIMIT].decode("utf-8", "replace"), r.returncode
        truncated, stderr = len(r.stdout) > OUTPUT_LIMIT, r.stderr.decode("utf-8", "replace")
    except subprocess.TimeoutExpired:
        stdout, code, truncated, stderr = "", None, False, ""

    result = CR.parse_review(stdout, code, gate, truncated)
    after = CR.snapshot(root)
    if result["state"] != "unconfirmed" and (after != before or not after["clean"]):
        result = {**result, "state": "unconfirmed", "reason": "리뷰하는 동안 코드가 바뀌었습니다."}
    CR.save_result(root, result, base, before)

    counts = ", ".join(f"{k} {v}" for k, v in sorted(result["counts"].items())) or "없음"
    others = [f for f in result["findings"] if f not in result["blockers"]]
    if result["state"] == "unconfirmed":
        tail = CR.redact(stderr.strip())[-800:]
        return stop(f"✗ {result['reason']}" + (f"\n{tail}" if tail else "") + UNCONFIRMED, 1)

    if result["state"] == "pass":
        CR.rounds_path(root).unlink(missing_ok=True)
        print(f"✓ CodeRabbit 통과 — {gate} 이상 지적 없음 (base `{base}`, 전체 지적: {counts}).\n"
              f"다음: `git push -u origin {before['branch']}` → `gh pr create --draft --base {base} ...`")
        if others:
            print("\n참고 지적 (막지 않음, PR 본문에 남겨라):\n" + "\n".join("- " + show(f, False) for f in others))
        return 0

    rounds += 1
    CR.write_rounds(root, rounds)
    print(f"✗ CodeRabbit: 막는 지적 {len(result['blockers'])}건 (전체: {counts}) — 라운드 {rounds}/{max_rounds}\n"
          f"{CR.UNTRUSTED}\n")
    print("\n".join(f"{i}. {show(f, True)}" for i, f in enumerate(result["blockers"], 1)))
    if others:
        print("\n참고 (막지 않음):\n" + "\n".join("- " + show(f, False) for f in others))
    if rounds >= max_rounds:
        print(f"\n{max_rounds}회 리뷰 후에도 막는 지적이 남았다. 더 고치지 말고 멈춰서 위 내용을 사용자에게 보고하라. "
              f"PR 을 만들지 마라. 사용자가 입력창에 `CR-RESET`을 입력하면 다시 시작할 수 있다.")
    else:
        print("\n" + NEXT)
    return 2


if __name__ == "__main__":
    sys.exit(main())
