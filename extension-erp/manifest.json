{
  "manifest_version": 3,
  "name": "ERP 마감일지 채우기",
  "version": "0.3.0",
  "description": "ERP 마감일지 화면에 이 PC의 도우미가 비트에서 센 숫자를 채웁니다. [기간 채우기]만 날마다 저장까지 누릅니다. 도우미 답은 저장하지 않습니다.",
  "permissions": [
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://erp.minesolution.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "main.js",
        "cells.js",
        "fill.js",
        "panel.js",
        "settings.js",
        "types.js",
        "errors.js",
        "erpday.js",
        "range.js",
        "rangeTypes.js",
        "rangeView.js",
        "uisTypes.js",
        "uisText.js",
        "josa.js",
        "uisSettings.js",
        "uisCells.js",
        "uisSheet.js",
        "zip.js",
        "xlsxWrite.js",
        "uisView.js",
        "uisFlow.js"
      ],
      "matches": [
        "https://erp.minesolution.com/*"
      ]
    }
  ],
  "options_page": "options.html",
  "key": ""
}
