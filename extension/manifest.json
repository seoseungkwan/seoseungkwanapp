{
  "manifest_version": 3,
  "name": "청구 사전점검 연결",
  "version": "0.1.1",
  "description": "병원 업무 사이트의 청구 사전점검 화면과 이 PC의 도우미를 이어 줍니다. 자료를 저장하지 않습니다.",
  "permissions": [
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "externally_connectable": {
    "matches": [
      "https://seoseungkwanapp.vercel.app/*"
    ]
  },
  "key": ""
}
