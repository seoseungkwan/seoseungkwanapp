<Project>
  <!-- ERP 도우미 전체가 같이 쓰는 설정(spec erp-closing-fill design.md 3-1). ERP 도우미 판(Version)은 이 한 곳에서만 정한다 (AC-3610.1).
       기존 도우미 판(helper/Directory.Build.props)과는 따로다. 참조하는 기존 Precheck.Core는 자기 helper/Directory.Build.props로 만들어진다.
       나머지 설정은 helper/Directory.Build.props와 같다 -->
  <PropertyGroup>
    <Version>0.1.0</Version>
    <Product>Seoseungkwan ERP Helper</Product>
    <Company>Seoseungkwan</Company>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- 판 글자에 git 커밋을 붙이지 않는다 -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <!-- NuGet 판은 각 csproj에 정확한 판으로만 적는다(범위·* 없음, 기존 도우미 csproj와 같은 판) -->
</Project>
