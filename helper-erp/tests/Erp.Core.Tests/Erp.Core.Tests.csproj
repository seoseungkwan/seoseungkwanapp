<Project Sdk="Microsoft.NET.Sdk">
  <!-- ERP 도우미 Core 시험(spec erp-closing-fill TASK-11). 이 PC·서버에서는 -f net10.0만, 윈도우 빌드에서는 net48도 돈다. 시험 파일 이름은 *.test.cs.
       패키지·판은 기존 helper/tests/Precheck.Core.Tests와 같다 -->
  <PropertyGroup>
    <TargetFrameworks>net10.0;net48</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Erp.Core.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <!-- 의사랑 .xls 시험(spec erp-uisarang ADR-050): net10.0만 코드 페이지 제공자를 시험 시작에서 등록한다(Uisarang/CodePagesSetup.cs).
         net48(도우미와 같은 틀)은 코드 페이지가 기본으로 있어 참조하지 않는다. .NET 10 SDK는 틀에 든 패키지라 NU1510(정리 권고)을 내므로 이 참조에서만 끈다 -->
    <PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.14" NoWarn="NU1510" />
  </ItemGroup>

  <ItemGroup>
    <!-- 가짜 의사랑 엑셀(fixtures/fake-uisarang, design.md 12-1)을 시험 출력 uisarang/ 아래로 복사한다. 실제 의원 파일은 없다 -->
    <None Include="../../../fixtures/fake-uisarang/*.xls" Link="uisarang/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Erp.Core/Erp.Core.csproj" />
    <ProjectReference Include="../../../helper/src/Precheck.Core/Precheck.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 기존 도우미 시험의 가짜 부품(가짜 DB·등록·봉투 모으기, 시험은 없음)을 고치지 않고 같이 쓴다. 이름공간은 Precheck.Core.Tests.* 그대로 -->
    <Compile Include="../../../helper/tests/Precheck.Core.Tests/Bit/Fakes.test.cs" Link="Shared/Bit/Fakes.test.cs" />
    <Compile Include="../../../helper/tests/Precheck.Core.Tests/Protocol/Support.test.cs" Link="Shared/Protocol/Support.test.cs" />
    <Compile Include="../../../helper/tests/Precheck.Core.Tests/Revenue/RevenueFakes.test.cs" Link="Shared/Revenue/RevenueFakes.test.cs" />
  </ItemGroup>
</Project>
