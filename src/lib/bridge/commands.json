{
  "protocol": 1,
  "hostName": "com.seoseungkwan.precheck",
  "origin": "https://seoseungkwanapp.vercel.app",
  "extensionId": "cmnefbmfclmjkfbnjnbfnlndlpjnihka",
  "extensionKey": "",
  "commands": {
    "hello": {
      "patient": false,
      "args": {}
    },
    "bit.check": {
      "patient": false,
      "args": {}
    },
    "bit.register": {
      "patient": false,
      "confirm": true,
      "args": {}
    },
    "claim.dates": {
      "patient": false,
      "maxDays": 400,
      "args": {
        "from": { "type": "date" },
        "to": { "type": "date" }
      }
    },
    "claim.month": {
      "patient": true,
      "maxDays": 35,
      "args": {
        "from": { "type": "date" },
        "to": { "type": "date" }
      }
    },
    "claim.memos": {
      "patient": true,
      "maxDays": 400,
      "args": {
        "from": { "type": "date" },
        "to": { "type": "date" }
      }
    },
    "store.load": {
      "patient": true,
      "args": {
        "months": { "type": "array", "optional": true, "min": 1, "max": 24, "items": { "type": "month" } },
        "settings": { "type": "bool", "optional": true },
        "contact": { "type": "bool", "optional": true }
      }
    },
    "store.save": {
      "patient": true,
      "send": true,
      "args": {
        "payload": {
          "type": "payload",
          "fields": {
            "month": { "type": "month", "optional": true },
            "drafts": { "type": "json", "of": "object", "optional": true },
            "done": { "type": "json", "of": "object", "optional": true },
            "journal": { "type": "json", "of": "object", "optional": true },
            "contact": { "type": "json", "of": "object", "optional": true },
            "settings": { "type": "json", "of": "object", "optional": true }
          }
        }
      }
    },
    "bit.input": {
      "patient": true,
      "send": true,
      "confirm": true,
      "args": {
        "payload": {
          "type": "payload",
          "fields": {
            "code": { "type": "string", "min": 1, "max": 20, "pattern": "^[0-9A-Z][0-9A-Z.-]{0,19}$", "optional": true },
            "items": {
              "type": "array",
              "min": 1,
              "max": 500,
              "items": {
                "type": "object",
                "fields": {
                  "visitKey": { "type": "string", "min": 1, "max": 64 },
                  "chart": { "type": "string", "min": 1, "max": 20, "pattern": "^[0-9]{1,20}$" },
                  "name": { "type": "string", "min": 1, "max": 100 },
                  "date": { "type": "date" },
                  "memo": { "type": "string", "min": 1, "max": 32000 },
                  "checkedByHand": { "type": "bool", "optional": true },
                  "replaces": { "type": "string", "min": 1, "max": 4000, "optional": true }
                }
              }
            }
          }
        }
      }
    },
    "sam.latest": {
      "patient": true,
      "args": {}
    },
    "contact.targets": {
      "patient": true,
      "maxDays": 1100,
      "args": {
        "kind": { "type": "enum", "values": ["followup", "injection", "lapsed", "reservation"] },
        "from": { "type": "date" },
        "to": { "type": "date" }
      }
    },
    "stats.rows": {
      "patient": true,
      "maxDays": 800,
      "args": {
        "from": { "type": "date" },
        "to": { "type": "date" }
      }
    },
    "revenue.days": {
      "patient": false,
      "maxDays": 31,
      "args": {
        "from": { "type": "date" },
        "to": { "type": "date" }
      }
    }
  },
  "erp": {
    "extensionId": "lkancaiekmoieooheifdimahhkejfmjc",
    "extensionKey": "",
    "commands": {
      "closing.codes": {
        "patient": false,
        "args": {}
      },
      "closing.day": {
        "patient": false,
        "args": {
          "date": { "type": "date" },
          "groups": {
            "type": "array",
            "min": 0,
            "max": 19,
            "items": {
              "type": "object",
              "fields": {
                "key": {
                  "type": "enum",
                  "values": ["carm", "sono", "arthro", "manual", "eswt", "pt", "etc1", "etc2", "etc3", "etc4",
                    "manualConsult", "lipus", "nail", "ct", "surgery", "eswtStd", "eswtRadial", "injection", "ptVisit"]
                },
                "codes": {
                  "type": "array",
                  "min": 1,
                  "max": 20,
                  "items": { "type": "string", "min": 1, "max": 20, "pattern": "^\\S{1,20}$" }
                }
              }
            }
          }
        }
      }
    }
  }
}
